{
    "name": "quattror/swagger",
    "description": "A swagger helper",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "quattror",
            "email": "ti@quattror.com.br"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0",
        "swagger-api/swagger-ui": "^5.18.3",
        "zircote/swagger-php": "^4.11",
        "doctrine/annotations": "^1.13 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Quattror\\Swagger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quattror\\Swagger\\SwaggerServiceProvider"
            ]
        }
    }
}
